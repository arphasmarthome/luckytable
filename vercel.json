{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd expo-app && npm ci",
  "buildCommand": "cd expo-app && npx expo export --platform web",
  "outputDirectory": "expo-app/dist",
  "rewrites": [{ "source": "/((?!_expo/|assets/|api/).*)", "destination": "/index.html" }]
}
